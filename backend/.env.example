# Backend runtime
CORS_ORIGINS=http://localhost:5173
# Supabase Connect > Session pooler URI, with the password URL-encoded.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
MAX_STEPS=8
MAX_RETRIES_PER_STEP=2
MAX_REPLANS=2
RETRY_BACKOFF_SECONDS=0.5

# FinAgent LLM provider configuration
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Financial research search configuration
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=30
OFFICIAL_DOMAINS=

# Set true when deploying behind HTTPS. Keep frontend/API on the same origin.
SECURE_COOKIES=false

# Alternative: enter the database password separately (automatically URL-encoded).
# Leave DATABASE_URL blank when using these values.
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
