# LLM (one provider for all agents)
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0

# Provider API keys (set the one matching LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Web search
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=30

# Comma-separated official domains for research tiering (e.g. rbi.org.in, sebi.gov.in)
OFFICIAL_DOMAINS=
